# ============================================================
# VisionForge-AI — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: Vite requires all env vars to start with VITE_
#       to be accessible in browser code.
# ============================================================

# ── Backend API ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws

# ── App ──────────────────────────────────────────────────────
VITE_APP_NAME=VisionForge-AI
VITE_APP_VERSION=1.0.0

# ── Feature Flags ────────────────────────────────────────────
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true

# ── Upload Limits ────────────────────────────────────────────
VITE_MAX_UPLOAD_SIZE_MB=20
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg
