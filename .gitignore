# ==============================================================================
# VisionForge AI — Clean Git Ignore
# ==============================================================================

# 1. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# 2. Virtual Environments
venv/
.venv/
env/
ENV/

# 3. Environment Variables & Secret Keys
.env
.env.local
*.env
backend/.env
frontend/.env
frontend/.env.local
!backend/.env.example

# 4. Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
dist-ssr/
.npm/
.tunnel.url
frontend/.tunnel.url

# 5. Testing & Test Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# 6. Local SQLite Databases
*.db
*.db-journal
*.sqlite3
*.sqlite3-journal
backend/data/*.db
backend/data/*.sqlite3

# 7. VisionForge Runtime Uploads & Reports
# (Keep folders via .gitkeep, ignore operator uploads and generated PDFs)
backend/data/inspection_uploads/*
!backend/data/inspection_uploads/.gitkeep
backend/data/reports/*
!backend/data/reports/.gitkeep

# 8. Heavy Training Datasets & Local Testing Folders
visionforge-dataset/
Vision_Forge_Testing/

# 9. IDEs, OS Files & Agent Artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
.gemini/
.claude/
.kilo/
.antigravity/

# 10. Private Interview Notes & Discussion Guides
interview_script.txt
*interview*
docs/*interview*