# ══════════════════════════════════════════════════════════════════════════════
# VisionForge-AI — Backend Environment Variables (Template)
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=VisionForge-AI
APP_VERSION=0.1.0
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/visionforge
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=generate-a-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Google Gemini (Primary VLM Agent, Secondary AI Judge) ──────────────────────
# Get free API key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VLM_MODEL=gemini-3.5-flash
GEMINI_JUDGE_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ── Groq (Primary AI Judge, Secondary VLM Agent) ──────────────────────────────
# Get free API key from: https://console.groq.com/
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VLM_MODEL=qwen/qwen3.8-27b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b

# ── Embedding / CLIP ───────────────────────────────────────────────────────────
CLIP_MODEL=openai/clip-vit-base-patch32
SIMILARITY_THRESHOLD=0.75
