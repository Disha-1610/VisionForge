# ============================================================
# VisionForge-AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME=VisionForge-AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key
API_VERSION=v1

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true
WORKERS=1

# ── Database (SQLite for local dev / PostgreSQL for production) ──
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./visionforge.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/visionforge
DATABASE_ECHO=false

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-strong-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ── File Storage ─────────────────────────────────────────────
UPLOAD_DIR=data/inspection_uploads
GOLDEN_IMAGE_DIR=data/golden_images
HEATMAP_DIR=data/heatmaps
REPORT_DIR=data/reports
ROI_TEMPLATE_DIR=data/roi_templates
FAISS_INDEX_DIR=data/faiss_index

# ── CLIP / Embedding ────────────────────────────────────────
CLIP_MODEL_NAME=ViT-B/32
FAISS_SIMILARITY_THRESHOLD=0.75

# ── NVIDIA NIM (LLM + Vision) ────────────────────────────────
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Text LLM — 124B MoE, 1M context, reasoning + function calling + structured output
NVIDIA_NIM_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_CHAT_MAX_TOKENS=16384

# Vision LLM — 33B, 262K context, image/video/text input, reasoning
NVIDIA_NIM_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_NIM_VISION_MAX_TOKENS=65536

NVIDIA_NIM_TIMEOUT=60
NVIDIA_NIM_TEMPERATURE=0.6
NVIDIA_NIM_TOP_P=0.95

# ── Groq Free Tier Fallback (Optional) ─────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# ── Pipeline Thresholds ─────────────────────────────────────
QUALITY_BLUR_THRESHOLD=100.0
QUALITY_MIN_RESOLUTION=640
AUTHENTICITY_THRESHOLD=0.7
FRAUD_SCORE_QUARANTINE_THRESHOLD=90
FRAUD_SCORE_REVIEW_THRESHOLD=60
CONFIDENCE_REVIEW_THRESHOLD=60

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Upstash Redis (Rate Limiting + Caching) ──────────────────
UPSTASH_REDIS_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Cache TTL (seconds)
CACHE_TTL_INSPECTION_RESULT=3600
CACHE_TTL_GOLDEN_REFERENCE=86400
CACHE_TTL_ANALYTICS=300
