# ══════════════════════════════════════════════════════════════════════════════
# VisionForge-AI — Backend Environment Variables (Template)
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=VisionForge-AI
APP_VERSION=0.1.0
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/visionforge
DATABASE_ECHO=false

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=generate-a-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── NVIDIA NIM (Primary VLM Agent, Secondary AI Judge) ─────────────────────────
# Get free API key from: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_VLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_NIM_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Groq (Primary AI Judge, Secondary VLM Agent) ──────────────────────────────
# Get free API key from: https://console.groq.com/
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VLM_MODEL=qwen/qwen3.6-27b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b

# ── Embedding / CLIP ───────────────────────────────────────────────────────────
CLIP_MODEL=openai/clip-vit-base-patch32
SIMILARITY_THRESHOLD=0.75
